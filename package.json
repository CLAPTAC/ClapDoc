{
  "name": "clapdoc",
  "version": "0.1.0",
  "description": "A framework-agnostic, block-based document editor (Editor.js-style Tool API) packaged as a Web Component, embeddable in any app.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CLAPTAC/ClapDoc.git"
  },
  "type": "module",
  "main": "./dist/doc-editor.cjs",
  "module": "./dist/doc-editor.js",
  "types": "./dist/doc-editor.d.ts",
  "unpkg": "./dist/doc-editor.global.js",
  "exports": {
    ".": {
      "types": "./dist/doc-editor.d.ts",
      "import": "./dist/doc-editor.js",
      "require": "./dist/doc-editor.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/doc-editor.js",
    "./dist/doc-editor.cjs",
    "./dist/doc-editor.global.js"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "editor",
    "block-editor",
    "wysiwyg",
    "web-component",
    "custom-element",
    "editor.js"
  ]
}
